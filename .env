# MongoDB
MONGO_INITDB_DATABASE=kpiusdb
MONGODB_URL=mongodb://mongodb:27017
DATABASE_NAME=kpiusdb

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://rabbitmq:5672

# Общие настройки
JWT_SECRET=your-secret-key
CORS_ORIGINS=http://localhost:3000
NODE_ENV=development

# API Gateway
API_GATEWAY_PORT=8000
AUTH_SERVICE_URL=http://auth-service:8001
USER_SERVICE_URL=http://user-service:8002
ATTENDANCE_SERVICE_URL=http://attendance-service:8003
NOTIFICATION_SERVICE_URL=http://notification-service:8004
REPORTING_SERVICE_URL=http://reporting-service:8005

# Auth Service
AUTH_SERVICE_PORT=8001
ACCESS_TOKEN_EXPIRE_MINUTES=30

# User Service
USER_SERVICE_PORT=8002

# Attendance Service
ATTENDANCE_SERVICE_PORT=8003

# Notification Service
NOTIFICATION_SERVICE_PORT=8004

# Reporting Service
REPORTING_SERVICE_PORT=8005

# Frontend
FRONTEND_PORT=3000
REACT_APP_API_URL=http://localhost:8000