# Общие настройки для всех сервисов
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_HEARTBEAT=30

# MongoDB настройки
MONGODB_URL=mongodb://localhost:27017

# Настройки для сервиса accounts
ACCOUNTS_DATABASE_NAME=accounts_db
JWT_SECRET=your-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ALGORITHM=HS256

# Настройки для сервиса grades
GRADES_DATABASE_NAME=grades_db
ACCOUNTS_SERVICE_URL=http://localhost:5001

# Настройки для сервиса attendance
ATTENDANCE_DATABASE_NAME=attendance_db
ATTENDANCE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/attendance

# Настройки для сервиса analytics
ANALYTICS_DATABASE_NAME=analytics_db

# Настройки серверов
HOST=0.0.0.0
PORT=8000
DEBUG=True